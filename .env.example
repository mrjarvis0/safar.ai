# Safar — environment template. Copy to `.env` and fill in. NEVER commit `.env`.
# The team lead provides the real keys.

# --- LLM (reasoning): NVIDIA NIM (OpenAI-compatible) ---
LLM_PROVIDER=nvidia          # nvidia | mock
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Models enabled on our account (reasoning is auto-disabled in llm.py):
#   nvidia/nemotron-3.5-lightning-30b-a3b  -> fast (default, best for the live demo)
#   nvidia/nemotron-3-super-120b-a12b      -> smarter but slower
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# --- Data APIs used by the gateway ---
# FREE + keyless (need NO key): OpenStreetMap (Nominatim/Overpass), Wikidata,
# Wikivoyage, Open-Meteo (forecast + historical archive), Frankfurter (FX).
#
# Amadeus = live flight/hotel PRICES. Optional: leave blank to use mock data.
# Get free test keys at https://developers.amadeus.com (Self-Service). When both
# are set, the gateway uses Amadeus and falls back to mock on any failure.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com   # -> https://api.amadeus.com for prod keys
ORIGIN_IATA=DEL                                 # traveler's home airport
