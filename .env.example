# Safar — environment template. Copy to `.env` and fill in. NEVER commit `.env`.
# The team lead provides the real keys.

# --- LLM (reasoning): NVIDIA NIM (OpenAI-compatible) ---
LLM_PROVIDER=nvidia          # nvidia | mock
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Models enabled on our account (reasoning is auto-disabled in llm.py):
#   nvidia/nemotron-3.5-lightning-30b-a3b  -> fast (default, best for the live demo)
#   nvidia/nemotron-3-super-120b-a12b      -> smarter but slower
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# --- Data APIs used by the gateway ---
# FREE + keyless (need NO key): OpenStreetMap (Nominatim/Overpass), Wikidata,
# Wikivoyage, Open-Meteo (forecast + historical archive), Frankfurter (FX).
#
# Amadeus = live flight/hotel PRICES. Optional: leave blank to use mock data.
# Get free test keys at https://developers.amadeus.com (Self-Service). When both
# are set, the gateway uses Amadeus and falls back to mock on any failure.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com   # -> https://api.amadeus.com for prod keys
ORIGIN_IATA=DEL                                 # traveler's home airport

# --- Live flight status (Phase 2b): delays -> On-Trip Copilot auto re-plan ---
# Optional. Leave blank to use a simulated delay in the demo. AviationStack is
# primary, AeroDataBox (RapidAPI) is the fallback — both have free tiers.
AVIATIONSTACK_API_KEY=                           # https://aviationstack.com (free: 100 req/mo)
AERODATABOX_API_KEY=                             # RapidAPI key for AeroDataBox (free tier)
# AERODATABOX_HOST=aerodatabox.p.rapidapi.com    # default; override only if RapidAPI changes it

# --- Routing (Phase 2c): OSRM — FREE + KEYLESS, needs no key ------------------
# Multiple road routes with fallback (taxi/bus can't reach -> next route). The
# public server is car-only + rate-limited; point at a self-hosted OSRM for more.
OSRM_BASE_URL=https://router.project-osrm.org

# --- NVIDIA Earth-2 FourCastNet (AI global weather) — SELF-HOSTED NIM (GPU) ---
# FourCastNet is deploy-only (NOT a hosted API). Deploy the NIM container
# (https://docs.nvidia.com/nim/earth-2/fourcastnet) and point FOURCASTNET_URL at
# it. Blank = disabled -> Safar falls back to Open-Meteo. Real inference needs an
# ERA5 initial-condition .npy (built via Earth2Studio); numpy parses the output.
FOURCASTNET_URL=                                # e.g. http://localhost:8000
FOURCASTNET_API_KEY=                            # optional; defaults to NVIDIA_API_KEY

# ============================================================================
# Phase 3 — real transactions + production. ALL OPTIONAL. Blank = safe defaults
# (simulate booking, mock payment, mock bus/train, SQLite). Nothing charges money
# until you set live keys AND a human confirms capture in the UI (readme §13).
# ============================================================================

# --- Booking mode: simulate (default) | live --------------------------------
# 'live' books a real flight (Amadeus Create Orders → PNR) + creates a real
# payment ORDER, but still hands capture to a human. Falls back to simulate if
# the keys below are missing.
SAFAR_BOOKING_MODE=simulate

# --- Payment PSP — order creation only; capture/refund are human-confirmed ----
# Safar never sees/stores/types card data (PSP hosted checkout owns PCI scope).
PAYMENT_PROVIDER=mock                            # mock | razorpay | stripe
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Intercity bus / train inventory (partner/paid; mock otherwise) ----------
REDBUS_API_KEY=
REDBUS_BASE_URL=                                 # RedBus-class bus aggregator base URL
RAIL_API_KEY=
RAIL_BASE_URL=                                   # IRCTC-class rail aggregator base URL

# --- Production data layer (readme §15) — blank = local SQLite / in-process ---
# Needs `pip install -r requirements-prod.txt` for the Postgres driver.
DATABASE_URL=                                    # postgresql://user:pass@host:5432/safar
REDIS_URL=                                       # redis://host:6379/0
